# Gitignore — Saree'e

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Editors / IDEs ---
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# --- Environment & secrets ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.keystore
*.jks
secrets/
credentials*.json
google-services.json
GoogleService-Info.plist

# --- Logs & temp ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
.cache/

# --- Node / NestJS (future) ---
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# --- Flutter / Dart (future) ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/doc/api/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/android/.gradle/
**/android/local.properties
**/android/app/debug
**/android/app/profile
**/android/app/release
**/build/
*.g.dart
*.freezed.dart

# --- Prisma / DB (future) ---
prisma/*.db
prisma/*.db-journal
*.sql.gz

# --- Docker / local infra ---
docker-compose.override.yml

# --- Test artifacts ---
/coverage
/test-results
/playwright-report

# --- Misc ---
*.orig
*.bak
.turbo/
.vercel/
