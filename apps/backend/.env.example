# Saree'e backend — copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# PostgreSQL (ADR-001)
DATABASE_URL=postgresql://sareee:sareee@localhost:5432/sareee?schema=public

# Redis (ADR-001)
REDIS_URL=redis://localhost:6379

# App
APP_NAME=sareee-backend
APP_VERSION=0.1.0

# Comma-separated browser origins allowed to call the API (Phase 1 health from demo client)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
