# Saree'e backend — copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# PostgreSQL (ADR-001)
DATABASE_URL=postgresql://sareee:sareee@localhost:5432/sareee?schema=public

# Redis (ADR-001)
REDIS_URL=redis://localhost:6379

# App
APP_NAME=sareee-backend
APP_VERSION=0.1.0

# Comma-separated browser origins allowed to call the API (Phase 1 health from demo client)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 2 — JWT access tokens (ADR-002). Min 32 chars. Rotate in production.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Bootstrap first admin: send header X-Bootstrap-Secret with this value on POST /auth/register/admin
# Leave empty to disable bootstrap registration after first admin exists.
BOOTSTRAP_ADMIN_SECRET=

# Local media adapter root (ADR-015 stand-in until MinIO). Empty = ./storage under cwd.
MEDIA_LOCAL_ROOT=
