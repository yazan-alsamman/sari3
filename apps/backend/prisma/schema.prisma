// Prisma schema — Phase 2 Identity + Phase 3 Zones & Pricing
// (ADR-002, ADR-003, ADR-015, ADR-005, ADR-006).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  driver
  admin
}

enum DriverApprovalStatus {
  pending
  approved
  rejected
  suspended
}

enum BasketSize {
  small
  large
}

enum MediaPurpose {
  driver_id
  shop_landmark
  delivery_proof
}

enum DeliveryMode {
  standard
  vip
}

enum WeightClass {
  light
  heavy
}

/// Schema bootstrap marker — Phase 1.
model SchemaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schema_meta")
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  passwordHash  String
  role          Role
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerProfile       CustomerProfile?
  driverProfile         DriverProfile?
  sessions              RefreshSession[]
  mediaObjects          MediaObject[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  pricingRuleVersions   PricingRuleVersion[]   @relation("PricingRuleAuthor")

  @@map("users")
}

model CustomerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model DriverProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique
  firstName          String
  lastName           String
  birthDate          DateTime             @db.Date
  vehicleDescription String
  basketSize         BasketSize
  /// Operational capacity hint (domain max active orders stays 2 per ADR-008/009).
  capacitySlots      Int                  @default(2)
  approvalStatus     DriverApprovalStatus @default(pending)
  idPhotoMediaId     String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  idPhoto MediaObject? @relation(fields: [idPhotoMediaId], references: [id])

  @@map("driver_profiles")
}

model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  deviceLabel  String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

model MediaObject {
  id            String       @id @default(cuid())
  ownerUserId   String?
  purpose       MediaPurpose
  storageKey    String
  mime          String
  bytes         Int
  confirmedAt   DateTime?
  createdAt     DateTime     @default(now())

  owner  User?          @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  driver DriverProfile?

  @@index([ownerUserId, purpose])
  @@map("media_objects")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  beforeJson  Json?
  afterJson   Json?
  reason      String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Named service area (ADR-005 v1 — no polygon required).
model ServiceZone {
  id          String   @id @default(cuid())
  code        String   @unique
  nameAr      String   @unique
  active      Boolean  @default(true)
  centroidLat Float?
  centroidLng Float?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("service_zones")
}

/// Versioned admin pricing config (ADR-006). Only one row should be active.
model PricingRuleVersion {
  id              String   @id @default(cuid())
  version         Int      @unique
  active          Boolean  @default(false)
  currencyCode    String
  currencyLabel   String
  /// Calculator config: zoneBases, crossZoneMultiplier, vipSurchargeRate, perStop, heavySurcharge, routeOverrides
  configJson      Json
  createdByUserId String?
  notes           String?
  createdAt       DateTime @default(now())

  createdBy User?           @relation("PricingRuleAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  snapshots PriceSnapshot[]

  @@index([active])
  @@map("pricing_rule_versions")
}

/// Immutable price breakdown at confirm time (ADR-006). Order linkage in Phase 4.
model PriceSnapshot {
  id                   String      @id @default(cuid())
  pricingRuleVersionId String
  pickupZoneId         String
  deliveryZoneId       String
  pickupZoneName       String
  deliveryZoneName     String
  mode                 DeliveryMode
  weightClass          WeightClass @default(light)
  intermediateStopCount Int        @default(0)
  currencyCode         String
  currencyLabel        String
  baseAmount           Int
  modeSurcharge        Int
  stopsSurcharge       Int
  heavySurcharge       Int         @default(0)
  totalAmount          Int
  componentsJson       Json
  createdAt            DateTime    @default(now())

  pricingRuleVersion PricingRuleVersion @relation(fields: [pricingRuleVersionId], references: [id])

  @@index([createdAt])
  @@map("price_snapshots")
}
